<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="650dp" android:gravity="center_horizontal" android:orientation="vertical" android:padding="28dp">
  <ImageView android:layout_width="88dp" android:layout_height="88dp" android:src="@drawable/ic_launcher" android:contentDescription="ཆུ་ཐིགས། / 水滴图标"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/app_title_bilingual" android:textSize="25sp" android:textStyle="bold" android:textColor="@color/ink" android:gravity="center" android:lineSpacingMultiplier="1.18" android:layout_marginTop="12dp"/>
  <TextView android:id="@+id/loginHint" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/login_hint" android:gravity="center" android:textSize="17sp" android:lineSpacingMultiplier="1.2" android:layout_marginTop="14dp"/>
  <EditText android:id="@+id/activationUser" android:layout_width="match_parent" android:layout_height="58dp" android:hint="@string/activation_user_hint" android:inputType="text" android:singleLine="true" android:layout_marginTop="20dp"/>
  <EditText android:id="@+id/activationKey" android:layout_width="match_parent" android:layout_height="58dp" android:hint="@string/activation_key_hint" android:inputType="numberPassword" android:maxLength="8" android:singleLine="true"/>
  <com.google.android.material.button.MaterialButton android:id="@+id/loginWithKey" android:layout_width="match_parent" android:layout_height="68dp" android:text="@string/action_activate" android:textSize="16sp" android:textAllCaps="false" android:layout_marginTop="10dp"/>
  <com.google.android.material.button.MaterialButton android:id="@+id/scanActivation" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="66dp" android:text="@string/action_scan_activation" android:textSize="15sp" android:textAllCaps="false" android:layout_marginTop="10dp"/>
  <TextView android:id="@+id/loginError" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textColor="@color/red" android:layout_marginTop="12dp"/>
  <com.google.android.material.button.MaterialButton android:id="@+id/copyLog" style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="56dp" android:text="@string/action_copy_log" android:textAllCaps="false"/>
</LinearLayout></ScrollView>
