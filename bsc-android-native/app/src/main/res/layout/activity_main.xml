<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/bg">
  <LinearLayout android:id="@+id/header" android:layout_width="match_parent" android:layout_height="72dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingHorizontal="16dp" android:background="#FFFFFF">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView android:id="@+id/title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/app_title_bilingual" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/ink" android:lineSpacingMultiplier="1.15"/><TextView android:id="@+id/status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ཞིབ་བཤེར་བྱེད་བཞིན་པ། / 正在检查…" android:textSize="11sp"/></LinearLayout>
    <com.google.android.material.button.MaterialButton android:id="@+id/sync" android:layout_width="wrap_content" android:layout_height="56dp" android:minWidth="64dp" android:text="@string/action_sync" android:textAllCaps="false" android:textSize="13sp" app:iconPadding="6dp"/>
  </LinearLayout>
  <FrameLayout android:id="@+id/content" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
  <LinearLayout android:id="@+id/tabs" android:layout_width="match_parent" android:layout_height="76dp" android:orientation="horizontal" android:background="#FFFFFF">
    <com.google.android.material.button.MaterialButton android:id="@+id/tabMap" style="@style/Widget.Material3.Button.TextButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="@string/nav_map" android:textAllCaps="false" android:textSize="12sp" app:iconGravity="textTop" app:iconSize="26dp" app:iconPadding="2dp"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/tabTasks" style="@style/Widget.Material3.Button.TextButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="@string/nav_tasks" android:textAllCaps="false" android:textSize="12sp" app:iconGravity="textTop" app:iconSize="26dp" app:iconPadding="2dp"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/tabUpload" style="@style/Widget.Material3.Button.TextButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="@string/nav_upload" android:textAllCaps="false" android:textSize="12sp" app:iconGravity="textTop" app:iconSize="26dp" app:iconPadding="2dp"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/tabMine" style="@style/Widget.Material3.Button.TextButton" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:text="@string/nav_mine" android:textAllCaps="false" android:textSize="12sp" app:iconGravity="textTop" app:iconSize="26dp" app:iconPadding="2dp"/>
  </LinearLayout>
</LinearLayout>
